# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini (clasificacion de noticias)
GEMINI_API_KEY=your-gemini-key

# GitHub (para subir el rate limit del scraper de repos)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Cron (debe coincidir entre Vercel y el secret de GitHub Actions)
CRON_SECRET=generate-a-long-random-string

# Twitter / X (array JSON de cookies para agent-twitter-client)
TWITTER_COOKIES='[{"key":"auth_token","value":"...","domain":".x.com","path":"/","secure":true,"httpOnly":true,"sameSite":"None"}]'
